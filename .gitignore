.venv/
.refresh-cache.json
.lock-state.json
mlye/__pycache__
wandb/
tests/__pycache__/
artifacts/
results_*.json
configs/temp.yaml
model.pth
results.json
libs/
__pycache__
/sim-*.yaml
/sim-*.log
simpost-*.log
sflow.py
/data-psid-*.yaml
/data-psid-*.log
/data-bpp-*.yaml
/data-bpp-*.log
.model_posteriors_*.pth

# Auto-generated per-compile version stamp (specs/results_format.md
# sec "Compile-time version stamp"). Regenerated by
# scripts/results_version_export.py before each latexmk run.
reports/version.tex

# The results_models per-section content-hash metadata is committed --
# carve it back out from the broad results_*.json gitignore at line 7.
!reports/results_models.metadata.json

# LaTeX build artefacts under reports/.
reports/*.aux
reports/*.fls
reports/*.fdb_latexmk
reports/*.log
reports/*.out
reports/*.toc
reports/*.lof
reports/*.lot

# Standalone per-figure / per-table PDFs generated by
# specs/build_standalone_pdfs.py. Derived from reports/figures/*.tex
# and reports/tab_*.tex; rebuild on demand.
reports/standalone/

# Large / regenerable data artefacts. data/ is rebuilt by
# scripts/psid_bpp_build.py from the external ICPSR extract in ext/;
# both hold multi-GB blobs that must not enter git history.
/data/
/ext/

# Run logs and scratch dumps.
/logs/
/scriptflow.log
/sf.json
/tmp.yaml
/spec.html
/report.html
/experiment_report.html
specs/Archive.tar.gz

# Bare-latex scratch (from ad-hoc `latex texput` runs) and stray tests.
/texput.*
/test_*.txt
.venv-replication/

# Local working folder for the figure code (integrated as scripts/fig_*.py)
/figures/


# Everything under output/ is regenerated by replicate.py. Tracked exceptions:
# the published outputs (regenerating overwrites them, so `git diff` shows the change).
/output/*
!/output/data/
/output/data/*
!/output/data/bpp_selection_table.json
!/output/bundles/
/output/bundles/*
!/output/bundles/*.json
!/output/bundles/cells/
/output/bundles/cells/*
!/output/bundles/cells/_bpp_hetero_scale_ivi_bootstrap_k40/
!/output/bundles/cells/_bpp_hetero_scale_ivi_bootstrap_k40_uncond/
/output/bundles/cells/_bpp_hetero_scale_ivi_bootstrap_k40*/*
!/output/bundles/cells/_bpp_hetero_scale_ivi_bootstrap_k40*/bootstrap_theta.json
