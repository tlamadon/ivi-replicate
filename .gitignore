# Environments and caches
.venv/
.venv-replication/
__pycache__/
.pytest_cache/
wandb/

# PSID-derived data must never enter git history (PSID Conditions of Use).
# data/raw/ holds the ICPSR 210782 input files (data.dta, tax9192.dta,
# natpr.dta); only its README is tracked. ext/ is the old input location.
/data/*
!/data/raw/
/data/raw/*
!/data/raw/README.md
/ext/
*.dta
*.npy
*.npz
*.parquet
*.feather
*.pkl
*.h5
*.rds
*.sav
# Model checkpoints (fitted on the data; regenerated by layer 2)
*.pth
*.pt

# Local working folder for the figure code (integrated as scripts/fig_*.py)
/figures/

# Dataverse upload bundle (built by scripts/make_dataverse_bundle.sh)
/dist/

# Everything under output/ is regenerated by replicate.py. Tracked exceptions:
# the published outputs (regenerating overwrites them, so `git diff` shows the change).
/output/*
!/output/data/
/output/data/*
!/output/data/bpp_selection_table.json
!/output/bundles/
/output/bundles/*
!/output/bundles/*.json
!/output/bundles/cells/
/output/bundles/cells/*
!/output/bundles/cells/_bpp_hetero_scale_ivi_bootstrap_k40/
!/output/bundles/cells/_bpp_hetero_scale_ivi_bootstrap_k40_uncond/
/output/bundles/cells/_bpp_hetero_scale_ivi_bootstrap_k40*/*
!/output/bundles/cells/_bpp_hetero_scale_ivi_bootstrap_k40*/bootstrap_theta.json
